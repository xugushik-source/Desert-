{
  "name": "deserto-demo",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deserto-db",
      "database_id": "REPLACE_WITH_NEW_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
}
